#!/usr/bin/env bash
# DOCKER-101 — personal tmux dashboard: whale spins 3x, settles, fastfetch loads
# its stats, then cursor appears (left) / btop full-height (right)
#
# Founder call (2026-09-01): the whale intro must replay on EVERY new Ghostty
# window/tab, not just once per login. tmux sessions are global — a single
# fixed session name ("dashboard") could only ever show the intro once, since
# every later window just reattached to whatever the first window already
# built (the old LANDMINE this replaced). Fixed by giving every invocation its
# own uniquely-named session, scoped to this process's PID — stable across the
# `exec` handoff from dashboard-or-shell, so each Ghostty window gets exactly
# one session for its whole lifetime. A `client-detached` hook kills that
# session the moment its window closes, so per-window sessions don't pile up
# as orphaned tmux state once nobody's attached to them.
set -euo pipefail

SESSION="dashboard-$$"
WINDOW="main"

# tmux refuses to `attach` a session from inside another tmux client (its own
# nesting guard: "sessions should be nested with care"). Use switch-client
# when already inside tmux, attach otherwise.
goto_session() {
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION"
  else
    exec tmux attach -t "$SESSION"
  fi
}

# A detached `tmux new-session -d` has no attached client yet, so it defaults to a
# fake 80x24 — it does NOT know this real terminal's actual size. Capture the real
# size from THIS shell (the one dashboard is actually being run from) first, and
# pass it explicitly so the session starts at the true size instead of tmux's
# fallback default.
REAL_COLS=$(tput cols)
REAL_LINES=$(tput lines)

tmux new-session -d -s "$SESSION" -n "$WINDOW" -x "$REAL_COLS" -y "$REAL_LINES"
tmux set-hook -t "$SESSION" client-detached "kill-session -t \"$SESSION\""

# tmux's -l sizes the NEW pane (btop) — btop hard-fails below 80 cols, so that's
# the floor, not a "comfortable" cushion above it. Founder feedback (2026-09-01):
# btop reads as too big at 85 — drop straight to the floor and let the whale pane
# take everything else, so a wider window makes the WHALE bigger, not btop.
BTOP_WIDTH=80
BTOP_MIN_WIDTH=80
BTOP_MIN_ROOM=20   # minimum cols the whale pane needs to still look like anything
TOTAL_WIDTH="$REAL_COLS"
if [ "$(( TOTAL_WIDTH - BTOP_WIDTH - 1 ))" -lt "$BTOP_MIN_ROOM" ]; then
  BTOP_WIDTH="$BTOP_MIN_WIDTH"
  echo "Window is only ${TOTAL_WIDTH} cols — btop kept at its minimum (80) so the whale pane still gets some room. Widen the window for more whale detail." >&2
fi

# THIRD landmine fixed here (found live, 2026-09-01): whale-spin-intro used to be
# launched into pane 1 BEFORE this split — it read `tput cols` against the FULL,
# un-split window width, centered itself for that width, and then this split
# immediately shrank the pane out from under it. Deterministic, not a race: the
# whale was miscentered (pushed left) on EVERY single launch. Split first, so
# pane 1 is already at its final width before whale-spin-intro ever reads it.
tmux split-window -h -t "$SESSION:$WINDOW" -l "$BTOP_WIDTH"
tmux send-keys -t "$SESSION:$WINDOW.2" "btop" C-m
tmux send-keys -t "$SESSION:$WINDOW.1" "whale-spin-intro ~/.config/fastfetch/umersprofile-stacked.jsonc" C-m

# The -l above only fixes the split at THIS moment's size. If the real Ghostty
# window hasn't finished settling yet (its GPU-accelerated open animation can
# still be resizing when this script's `tput cols` ran), tmux rescales both
# panes proportionally the moment the real client actually attaches at its
# final size — and that rescale does NOT preserve the fixed 80-col btop width
# (reproduced directly: a 150-col build settling to 188 cols on attach came out
# 88/99, not the intended 107/80). Re-pin btop back to its floor on both events
# that can carry a late resize — the client attaching, and any resize after.
#
# LANDMINE fixed here (found live, 2026-09-01): the first cut of this re-pin
# blindly forced btop to $BTOP_WIDTH regardless of the window's actual size —
# on a genuinely narrow window (a smaller second monitor, ~<101 real cols) it
# tried to force 80 anyway, leaving btop's own pane BELOW its own hard minimum
# (observed: btop pane landed at 75 cols and printed its own "terminal size
# too small" error, whale squeezed to a sliver). Re-check the window's LIVE
# width every time the hook fires and only force the floor if there's
# actually room for both panes — otherwise leave tmux's own proportional
# layout alone rather than fighting it into a state neither pane can render.
#
# SECOND landmine fixed here (found live, 2026-09-01): the first cut built this
# hook as an inline bash string with escaped nested double-quotes. That string
# tested fine standalone (`bash -c "$REPIN_BTOP"`), but tmux re-parses a hook's
# STORED command through its own command-line parser when the hook actually
# fires — an untested second parse pass that silently stripped the embedded
# quotes, leaving a bare `$w` that always evaluated empty (`tmux show-hooks`
# confirmed the stored command was `if [  -ge 101 ]` — the guard never worked
# even once). Moved the logic into a real script file — plain space-separated
# argv has no nested-quoting layer left for either parser to mangle.
REPIN_HELPER="$HOME/dotfiles/bin/dashboard-repin-btop"
MIN_TOTAL_FOR_REPIN=$((BTOP_WIDTH + 1 + BTOP_MIN_ROOM))
tmux set-hook -t "$SESSION" client-attached "run-shell '$REPIN_HELPER $SESSION $WINDOW $BTOP_WIDTH $MIN_TOTAL_FOR_REPIN'"
tmux set-hook -t "$SESSION" client-resized "run-shell '$REPIN_HELPER $SESSION $WINDOW $BTOP_WIDTH $MIN_TOTAL_FOR_REPIN'"

tmux select-pane -t "$SESSION:$WINDOW.1"

goto_session
