#!/usr/bin/env bash
# DOCKER-101 — personal tmux dashboard: fastfetch (left) / btop, Catppuccin Mocha (right)
set -euo pipefail

SESSION="dashboard"
WINDOW="main"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

tmux new-session -d -s "$SESSION" -n "$WINDOW"
tmux send-keys -t "$SESSION:$WINDOW" "whale-spin-intro ~/.config/fastfetch/umersprofile-simple.jsonc" C-m

tmux split-window -h -t "$SESSION:$WINDOW" -p 50
tmux send-keys -t "$SESSION:$WINDOW.2" "btop" C-m

tmux select-pane -t "$SESSION:$WINDOW.1"

exec tmux attach -t "$SESSION"
