#!/usr/bin/env bash
# Plays a short spin-in animation (pre-rendered ANSI frames of the whale rotating),
# settles on a fixed frame, then fastfetch's stats print directly below it (logo
# disabled in fastfetch itself — the whale on screen already IS the logo). The
# whale keeps its original centered position; the stats text has its own
# independent left margin (founder: moving the text should not move the whale).
# Ghostty has no native support for animated Kitty-protocol logos (confirmed by
# the Ghostty maintainer, ghostty-org/ghostty discussion #5218) so this is a
# plain text flipbook instead, which works in any terminal.
set -euo pipefail

CONFIG="${1:-$HOME/.config/fastfetch/umersprofile-stacked.jsonc}"
FRAMES_DIR="$HOME/.config/fastfetch/centered-frames"
FULL_LAPS="${2:-2}"
STOP_FRAME="${3:-5}"   # b05 = 60deg
FRAME_DELAY="${4:-0.05}"

FRAME_WIDTH=50
FRAME_HEIGHT=13
STATS_HEIGHT=12

# Fastfetch's stats text gets its own small fixed left margin, independent of
# the whale's position (founder, 2026-09-01: "you moved the whale too, I just
# wanted the text moved").
STATS_LEFT_PAD_N=2
STATS_LEFT_PAD=$(printf '%*s' "$STATS_LEFT_PAD_N" '')

tput civis 2>/dev/null || true
trap 'tput cnorm 2>/dev/null || true' EXIT

# Pane width/height are read FRESH on every frame, not cached once at the top —
# Ghostty's GPU-accelerated open animation can still be resizing the window when
# this script starts (split-window happens before Ghostty has settled), so a
# one-shot `tput cols` read here can capture a stale, too-narrow width. That
# stale width clamps WHALE_LEFT_PAD_N to 0 (whale pinned flush left) and never
# gets recomputed once printed — tmux doesn't reflow already-written text on a
# later resize. Recomputing per-frame means the LAST frame drawn (the settled
# one fastfetch prints under) always reflects the pane's actual final size.
print_frame() {
  local pane_width pane_height whale_pad_n whale_pad top_pad_n
  pane_width=$(tput cols)
  pane_height=$(tput lines)

  whale_pad_n=$(( (pane_width - FRAME_WIDTH) / 2 ))
  [ "$whale_pad_n" -lt 0 ] && whale_pad_n=0
  [ "$whale_pad_n" -gt 60 ] && whale_pad_n=60
  whale_pad=$(printf '%*s' "$whale_pad_n" '')

  # Biased toward the top of the leftover space, not dead-centered (/2) — an even
  # split left too much empty space above the whale relative to below it once
  # fastfetch's stats + the shell prompt print underneath. /3, then -3 (2026-09-01,
  # first two passes) still not high enough per live founder feedback — bumped
  # TOP_PAD_TRIM again rather than picking a new fraction blind.
  local TOP_PAD_TRIM=5
  top_pad_n=$(( (pane_height - FRAME_HEIGHT - STATS_HEIGHT) / 3 - TOP_PAD_TRIM ))
  [ "$top_pad_n" -lt 0 ] && top_pad_n=0
  [ "$top_pad_n" -gt 30 ] && top_pad_n=30

  for ((p = 0; p < top_pad_n; p++)); do echo; done
  sed "s/^/${whale_pad}/" "$1"
}

for ((i = 0; i < FULL_LAPS; i++)); do
  for f in "$FRAMES_DIR"/b*.ansi; do
    clear
    print_frame "$f"
    sleep "$FRAME_DELAY"
  done
done

for ((n = 0; n <= STOP_FRAME; n++)); do
  clear
  print_frame "$FRAMES_DIR/b$(printf '%02d' "$n").ansi"
  sleep "$FRAME_DELAY"
done

tput cnorm 2>/dev/null || true
while read -r -t 0.05 -n 1000 _discard; do :; done 2>/dev/null || true
# No clear, no cursor-home: the whale stays exactly as printed above, and fastfetch
# (logo disabled) prints its stats starting right where the cursor already is —
# directly below the settled whale, using its own STATS_LEFT_PAD (not the
# whale's), so the two can be repositioned independently.
fastfetch --pipe false --config "$CONFIG" | sed "s/^/${STATS_LEFT_PAD}/"
exec "$SHELL" -l
