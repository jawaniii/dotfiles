#!/usr/bin/env bash
# DOCKER-101 — toggle the btop pane in/out of the 3-pane dashboard (whale-loop left,
# btop top-right, shell bottom-right) without killing the session or the shell pane.
set -uo pipefail

SESSION="dashboard"
WINDOW="main"

btop_pane=$(tmux list-panes -t "${SESSION}:${WINDOW}" -F '#{pane_id} #{pane_current_command}' 2>/dev/null \
  | awk '$2 == "btop" {print $1; exit}')

if [ -n "$btop_pane" ]; then
  tmux kill-pane -t "$btop_pane"
  exit 0
fi

# not currently shown -> recreate it above the shell pane in the right column
target=$(tmux list-panes -t "${SESSION}:${WINDOW}" -F '#{pane_id} #{pane_left}' 2>/dev/null \
  | sort -k2 -n | tail -1 | cut -d' ' -f1)

if [ -n "$target" ]; then
  tmux split-window -v -b -t "$target" -p 65
  tmux send-keys -t "${SESSION}:${WINDOW}" "btop" C-m
fi
