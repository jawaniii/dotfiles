{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/whale-3d-logo.ansi",
    "width": 57,
    "height": 14
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "shell",
    "terminal",
    "cpu",
    "packages",
    {
      "type": "command",
      "key": "Docker",
      "text": "docker --version"
    },
    "break",
    "colors"
  ]
}
